{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "modsync",
  "version": "0.1.0",
  "identifier": "com.nvoid.modsync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "modsync",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEMTdDNzBGNkFEQkY0OTUKUldTVjlOdHFEOGNYclloWTdnbSs5M3EwWFEvZ29wNzdlRlJuYkFFQk5EbDlNWTdHdi9OdzFQOFYK",
      "endpoints": [
        "https://github.com/null00void/modsync/releases/latest/download/latest.json"
      ]
    }
  }
}
